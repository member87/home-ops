    {
      "collapsed": false,
      "panels": [],
      "title": "Certificates",
      "type": "row",
      "id": 12,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 9
      }
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${promDatasource}"
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "filterable": true
          },
          "noValue": "-"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Expires In"
            },
            "properties": [
              {
                "id": "unit",
                "value": "dtdurations"
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "red",
                      "value": null
                    },
                    {
                      "color": "orange",
                      "value": 604800
                    },
                    {
                      "color": "green",
                      "value": 1209600
                    }
                  ]
                }
              },
              {
                "id": "color",
                "value": {
                  "mode": "thresholds"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Renews In"
            },
            "properties": [
              {
                "id": "unit",
                "value": "dtdurations"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Ready"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "options": {
                      "0": {
                        "color": "red",
                        "index": 0,
                        "text": "Not ready"
                      },
                      "1": {
                        "color": "green",
                        "index": 1,
                        "text": "Ready"
                      }
                    },
                    "type": "value"
                  }
                ]
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "cellHeight": "sm",
        "showHeader": true,
        "sortBy": [
          {
            "desc": false,
            "displayName": "Expires In"
          }
        ]
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${promDatasource}"
          },
          "editorMode": "code",
          "expr": "max by (namespace, name, issuer_name) (certmanager_certificate_expiration_timestamp_seconds{job=\"kubernetes-pods\", kubernetes_namespace=\"cert-manager\"}) - time()",
          "refId": "A",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${promDatasource}"
          },
          "editorMode": "code",
          "expr": "max by (namespace, name, issuer_name) (certmanager_certificate_renewal_timestamp_seconds{job=\"kubernetes-pods\", kubernetes_namespace=\"cert-manager\"}) - time()",
          "refId": "B",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${promDatasource}"
          },
          "editorMode": "code",
          "expr": "max by (namespace, name, issuer_name) (certmanager_certificate_ready_status{job=\"kubernetes-pods\", kubernetes_namespace=\"cert-manager\", condition=\"True\"})",
          "refId": "C",
          "instant": true,
          "range": false,
          "format": "table"
        }
      ],
      "title": "Certificates",
      "type": "table",
      "transformations": [
        {
          "id": "labelsToFields",
          "options": {
            "mode": "columns"
          }
        },
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "renameByName": {
              "namespace": "Namespace",
              "name": "Certificate",
              "issuer_name": "Issuer",
              "Value #A": "Expires In",
              "Value #B": "Renews In",
              "Value #C": "Ready"
            },
            "indexByName": {
              "namespace": 0,
              "name": 1,
              "Value #C": 2,
              "Value #A": 3,
              "Value #B": 4,
              "issuer_name": 5
            }
          }
        }
      ],
      "description": "Every Certificate, soonest expiry first. Renews In is negative when the renewal time has passed.",
      "id": 13,
      "gridPos": {
        "h": 12,
        "w": 24,
        "x": 0,
        "y": 10
      }
    },
