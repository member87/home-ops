      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${promDatasource}"
          },
          "editorMode": "code",
          "expr": "max by (app) (label_replace(up{kubernetes_namespace=\"flux-system\"}, \"app\", \"$1\", \"app_kubernetes_io_name\", \"(flux-operator)\"))",
