{
  "uid": "jevil",
  "title": "Jevil",
  "description": "What Jevil rules, labels and merges, when, and what Jev costs. docs/jevil.md",
  "tags": [
    "infrastructure",
    "jevil",
    "renovate"
  ],
  "schemaVersion": 40,
  "editable": true,
  "graphTooltip": 1,
  "time": {
    "from": "now-7d",
    "to": "now"
  },
  "refresh": "1m",
  "timezone": "browser",
  "templating": {
    "list": [
      {
        "name": "promDatasource",
        "label": "Prometheus",
        "type": "datasource",
        "query": "prometheus",
        "current": {
          "text": "Prometheus",
          "value": "prometheus"
        },
        "multi": false
      },
      {
        "name": "lokiDatasource",
        "label": "Loki",
        "type": "datasource",
        "query": "loki",
        "current": {
          "text": "Loki",
          "value": "loki"
        },
        "multi": false
      }
    ]
  },
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      },
      {
        "name": "Merges",
        "enable": true,
        "datasource": {
          "type": "loki",
          "uid": "${lokiDatasource}"
        },
        "iconColor": "purple",
        "expr": "{namespace=\"jevil\"} | json | msg=~\"merged|deploy unhealthy\"",
        "titleFormat": "{{msg}}",
        "textFormat": "PR #{{pr}}",
        "tagKeys": "msg"
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Status",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Last poll",
      "datasource": {
        "type": "prometheus",
        "uid": "${promDatasource}"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 0,
        "y": 1
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${promDatasource}"
          },
          "expr": "time() - max(jevil_last_cycle_timestamp_seconds)",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 600
              },
              {
                "color": "red",
                "value": 900
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "auto",
        "justifyMode": "auto"
      },
      "description": "Time since the last poll cycle completed. Jevil polls every 5 minutes; over 15 minutes means it is stuck or failing (see Errors and the log below)."
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Merging",
      "datasource": {
        "type": "prometheus",
        "uid": "${promDatasource}"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 4,
        "y": 1
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${promDatasource}"
          },
          "expr": "max(jevil_queue_halted)",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "running",
                  "index": 0
                },
                "1": {
                  "text": "HALTED",
                  "index": 1
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "auto",
        "justifyMode": "auto"
      },
      "description": "HALTED while a pull request carries jevil:merged-unhealthy: a merged deploy failed its check, a revert pull request is waiting for you, and Jevil merges nothing until the label is removed."
    },
    {
      "id": 4,
      "type": "table",
      "title": "Mode",
      "datasource": {
        "type": "prometheus",
        "uid": "${promDatasource}"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 8,
        "y": 1
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${promDatasource}"
          },
          "expr": "max by (scope, mode, model, policy) (jevil_info)",
          "instant": true,
          "range": false,
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "description": "shadow: Jevil labels and comments, you merge. merge: Jevil merges what passes. Set per scope in apps/jevil/policy.json.",
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "Value": true
            },
            "indexByName": {
              "scope": 0,
              "mode": 1,
              "model": 2,
              "policy": 3
            }
          }
        }
      ]
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Open pull requests by ruling",
      "datasource": {
        "type": "prometheus",
        "uid": "${promDatasource}"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 14,
        "y": 1
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${promDatasource}"
          },
          "expr": "sum by (ruling) (jevil_rulings)",
          "legendFormat": "{{ruling}}",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "pass"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "green"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "review"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "orange"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "wait"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "yellow"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value_and_name",
        "justifyMode": "auto"
      },
      "description": "Open Chore Bore pull requests by Jevil's current ruling: pass, review (a human decides) or wait (a status, release age or reconcile is pending)."
    },
    {
      "id": 6,
      "type": "stat",
      "title": "Errors (24h)",
      "datasource": {
        "type": "prometheus",
        "uid": "${promDatasource}"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 20,
        "y": 1
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${promDatasource}"
          },
          "expr": "sum(increase(jevil_cycle_errors_total[24h])) + sum(increase(jevil_ruling_errors_total[24h])) or vector(0)",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              },
              {
                "color": "red",
                "value": 10
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "auto",
        "justifyMode": "auto"
      },
      "description": "Failed poll cycles plus pull requests Jevil could not rule on, last 24 hours. The log below names the cause."
    },
    {
      "id": 31,
      "type": "row",
      "title": "Merge queue (/jevil merge)",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 5
      },
      "panels": []
    },
    {
      "id": 32,
      "type": "stat",
      "title": "Queued",
      "datasource": {
        "type": "prometheus",
        "uid": "${promDatasource}"
      },
      "gridPos": {
        "h": 7,
        "w": 4,
        "x": 0,
        "y": 6
      },
      "description": "Pull requests waiting for Jevil after /jevil merge: on a pending check, or behind a deploy that is being checked.",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${promDatasource}"
          },
          "expr": "max(jevil_queue_length) or vector(0)",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "decimals": 0,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto",
        "justifyMode": "auto"
      }
    },
    {
      "id": 33,
      "type": "timeseries",
      "title": "Commands",
      "datasource": {
        "type": "prometheus",
        "uid": "${promDatasource}"
      },
      "gridPos": {
        "h": 7,
        "w": 10,
        "x": 4,
        "y": 6
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${promDatasource}"
          },
          "expr": "sum by (command) (increase(jevil_commands_total[1h]))",
          "legendFormat": "{{command}}",
          "interval": "1h"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "decimals": 0,
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 80,
            "lineWidth": 1,
            "stacking": {
              "mode": "normal",
              "group": "A"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 34,
      "type": "timeseries",
      "title": "Merged and dequeued",
      "datasource": {
        "type": "prometheus",
        "uid": "${promDatasource}"
      },
      "gridPos": {
        "h": 7,
        "w": 10,
        "x": 14,
        "y": 6
      },
      "description": "merged: by /jevil merge (command) or on Jevil's own ruling (renovate). dequeued: a readiness check failed; the pull request comment says which.",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${promDatasource}"
          },
          "expr": "sum by (kind) (increase(jevil_merges_total[1h]))",
          "legendFormat": "merged {{kind}}",
          "interval": "1h"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "${promDatasource}"
          },
          "expr": "sum(increase(jevil_dequeues_total[1h]))",
          "legendFormat": "dequeued",
          "interval": "1h"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "decimals": 0,
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 80,
            "lineWidth": 1,
            "stacking": {
              "mode": "normal",
              "group": "A"
            }
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "dequeued"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "orange"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 7,
      "type": "row",
      "title": "What it is doing",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 13
      },
      "panels": []
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Rulings written",
      "datasource": {
        "type": "prometheus",
        "uid": "${promDatasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 14
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${promDatasource}"
          },
          "expr": "sum by (ruling) (increase(jevil_ruling_changes_total[1h]))",
          "legendFormat": "{{ruling}}",
          "interval": "1h"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "decimals": 0,
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 80,
            "lineWidth": 1,
            "stacking": {
              "mode": "normal",
              "group": "A"
            },
            "barAlignment": 0
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "description": "Each bar is an hour. A ruling is written when it changes: a new pull request, a new head commit, a status turning green, or a policy change."
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Open pull requests by ruling",
      "datasource": {
        "type": "prometheus",
        "uid": "${promDatasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 14
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${promDatasource}"
          },
          "expr": "sum by (ruling) (jevil_rulings)",
          "legendFormat": "{{ruling}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "decimals": 0,
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 40,
            "lineWidth": 2,
            "showPoints": "never",
            "stacking": {
              "mode": "normal",
              "group": "A"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Merges and deploy checks",
      "datasource": {
        "type": "prometheus",
        "uid": "${promDatasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 22
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${promDatasource}"
          },
          "expr": "sum by (kind) (increase(jevil_merges_total[1h]))",
          "legendFormat": "merged {{kind}}",
          "interval": "1h"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "${promDatasource}"
          },
          "expr": "sum by (outcome) (increase(jevil_verifications_total[1h]))",
          "legendFormat": "deploy {{outcome}}",
          "interval": "1h"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "decimals": 0,
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 80,
            "lineWidth": 1,
            "stacking": {
              "mode": "normal",
              "group": "A"
            },
            "barAlignment": 0
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "deploy unhealthy"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "red"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "description": "Every merge Jevil made (command or renovate) and the outcome of the deploy check after it (ok or unhealthy)."
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Labels written",
      "datasource": {
        "type": "prometheus",
        "uid": "${promDatasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 22
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${promDatasource}"
          },
          "expr": "sum by (action) (increase(jevil_label_writes_total[1h]))",
          "legendFormat": "{{action}}",
          "interval": "1h"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "decimals": 0,
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 80,
            "lineWidth": 1,
            "stacking": {
              "mode": "normal",
              "group": "A"
            },
            "barAlignment": 0
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "Poll cycle duration",
      "datasource": {
        "type": "prometheus",
        "uid": "${promDatasource}"
      },
      "gridPos": {
        "h": 7,
        "w": 8,
        "x": 0,
        "y": 30
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${promDatasource}"
          },
          "expr": "histogram_quantile(0.5, sum by (le) (rate(jevil_cycle_duration_seconds_bucket[30m])))",
          "legendFormat": "p50"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "${promDatasource}"
          },
          "expr": "histogram_quantile(0.95, sum by (le) (rate(jevil_cycle_duration_seconds_bucket[30m])))",
          "legendFormat": "p95"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineWidth": 2,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "GitHub API requests",
      "datasource": {
        "type": "prometheus",
        "uid": "${promDatasource}"
      },
      "gridPos": {
        "h": 7,
        "w": 8,
        "x": 8,
        "y": 30
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${promDatasource}"
          },
          "expr": "sum by (method, status) (increase(jevil_github_requests_total[1h]))",
          "legendFormat": "{{method}} {{status}}",
          "interval": "1h"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "decimals": 0,
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 80,
            "lineWidth": 1,
            "stacking": {
              "mode": "normal",
              "group": "A"
            },
            "barAlignment": 0
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
