    {
      "datasource": {
        "type": "prometheus",
        "uid": "${promDatasource}"
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "filterable": true
          },
          "noValue": "All SealedSecrets synced"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Synced"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "options": {
                      "-1": {
                        "color": "red",
                        "index": 0,
                        "text": "Not synced"
                      },
                      "0": {
                        "color": "orange",
                        "index": 1,
                        "text": "Unknown"
                      },
                      "1": {
                        "color": "green",
                        "index": 2,
                        "text": "Synced"
                      }
                    },
                    "type": "value"
                  }
                ]
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "cellHeight": "sm",
        "showHeader": true
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${promDatasource}"
          },
          "editorMode": "code",
          "expr": "max by (namespace, name) (sealed_secrets_controller_condition_info{job=\"sealed-secrets\", condition=\"Synced\"} != 1)",
          "refId": "A",
          "instant": true,
          "range": false
        }
      ],
      "title": "SealedSecrets Not Synced",
      "type": "table",
      "transformations": [
        {
          "id": "labelsToFields",
          "options": {
            "mode": "columns"
          }
        },
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "renameByName": {
              "namespace": "Namespace",
              "name": "SealedSecret",
              "Value": "Synced"
            },
            "indexByName": {
              "namespace": 0,
              "name": 1,
              "Value": 2
            }
          }
        }
      ],
      "description": "Only SealedSecrets that are not synced. The reason is in the controller log panel.",
      "id": 9,
      "gridPos": {
        "h": 8,
        "w": 10,
        "x": 0,
        "y": 6
      }
