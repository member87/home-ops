{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "description": "Terrakube (Terraform/OpenTofu automation): MinIO state store health and S3 traffic, Dex OIDC logins, the internet-facing GitHub webhook gate (Loki + Traefik) and container resources for every Terrakube component.",
  "editable": false,
  "graphTooltip": 1,
  "panels": [
    {
      "id": 1,
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": [],
      "title": "Overview",
      "type": "row"
    },
    {
      "id": 2,
      "datasource": {
        "type": "prometheus",
        "uid": "${promDatasource}"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          },
          "unit": "none",
          "decimals": 0
        },
        "overrides": []
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 0,
        "y": 1
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${promDatasource}"
          },
          "editorMode": "code",
          "expr": "sum(kube_deployment_status_replicas_unavailable{namespace=\"terrakube\"}) + sum(kube_statefulset_replicas{namespace=\"terrakube\"} - kube_statefulset_status_replicas_ready{namespace=\"terrakube\"})",
          "refId": "A",
          "instant": true,
          "range": false
        }
      ],
      "title": "Unavailable Replicas",
      "type": "stat",
      "description": "Replicas not ready across Terrakube's deployments (api, executor, ui, dex, minio, valkey, webhook-gate) and the postgresql statefulset."
    },
    {
      "id": 3,
      "datasource": {
        "type": "prometheus",
        "uid": "${promDatasource}"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "mappings": [
            {
              "options": {
                "0": {
                  "color": "red",
                  "index": 0,
                  "text": "UNHEALTHY"
                },
                "1": {
                  "color": "green",
                  "index": 1,
                  "text": "HEALTHY"
                }
              },
              "type": "value"
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          },
          "unit": "none"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 4,
        "y": 1
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${promDatasource}"
          },
          "editorMode": "code",
          "expr": "max(minio_cluster_health_status{job=\"terrakube-minio\"}) or vector(0)",
          "refId": "A",
          "instant": true,
          "range": false
        }
      ],
      "title": "State Store (MinIO)",
      "type": "stat",
      "description": "MinIO cluster health (minio_cluster_health_status). This MinIO holds the Terraform state; DOWN also when it cannot be scraped."
    },
    {
      "id": 4,
      "datasource": {
        "type": "prometheus",
        "uid": "${promDatasource}"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          },
          "unit": "none",
          "decimals": 0
        },
        "overrides": []
      },
      "gridPos": {
        "h": 4,
        "w": 3,
        "x": 8,
        "y": 1
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${promDatasource}"
          },
          "editorMode": "code",
          "expr": "sum(minio_cluster_drive_offline_total{job=\"terrakube-minio\"})",
          "refId": "A",
          "instant": true,
          "range": false
        }
      ],
      "title": "Drives Offline",
      "type": "stat",
      "description": "MinIO drives reported offline (single-drive deployment: any offline drive means the state store is unavailable)."
    },
    {
      "id": 5,
      "datasource": {
        "type": "prometheus",
        "uid": "${promDatasource}"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "mappings": [
            {
              "options": {
                "0": {
                  "color": "red",
                  "index": 0,
                  "text": "DOWN"
                },
                "1": {
                  "color": "green",
                  "index": 1,
                  "text": "UP"
                }
              },
              "type": "value"
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          },
          "unit": "none"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 4,
        "w": 3,
        "x": 11,
        "y": 1
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${promDatasource}"
          },
          "editorMode": "code",
          "expr": "max(up{job=\"terrakube-dex\"}) or vector(0)",
          "refId": "A",
          "instant": true,
          "range": false
        }
      ],
      "title": "Dex",
      "type": "stat",
      "description": "Whether Prometheus can scrape Dex's telemetry port. Dex is Terrakube's OIDC provider (federating to Pocket ID)."
    },
    {
      "id": 6,
      "datasource": {
        "type": "prometheus",
        "uid": "${promDatasource}"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          },
          "unit": "bytes",
          "decimals": 1
        },
        "overrides": []
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 14,
        "y": 1
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${promDatasource}"
          },
          "editorMode": "code",
          "expr": "max(minio_cluster_usage_total_bytes{job=\"terrakube-minio\"})",
          "refId": "A",
          "instant": true,
          "range": false
        }
      ],
      "title": "State Data Size",
      "type": "stat",
      "description": "Total size of all objects in MinIO (all versions), as last computed by MinIO's scanner."
    },
    {
      "id": 7,
      "datasource": {
        "type": "prometheus",
        "uid": "${promDatasource}"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          },
          "unit": "none",
          "decimals": 0
        },
        "overrides": []
      },
      "gridPos": {
        "h": 4,
        "w": 3,
        "x": 18,
        "y": 1
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${promDatasource}"
          },
          "editorMode": "code",
          "expr": "max(minio_cluster_usage_object_total{job=\"terrakube-minio\"})",
          "refId": "A",
          "instant": true,
          "range": false
        }
      ],
      "title": "State Objects",
      "type": "stat",
      "description": "Objects stored in MinIO (state files, plan/log artifacts)."
    },
    {
      "id": 8,
      "datasource": {
        "type": "prometheus",
        "uid": "${promDatasource}"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              },
              {
                "color": "red",
                "value": 3
              }
            ]
          },
          "unit": "none",
          "decimals": 0
        },
        "overrides": []
      },
      "gridPos": {
        "h": 4,
        "w": 3,
        "x": 21,
        "y": 1
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${promDatasource}"
          },
          "editorMode": "code",
          "expr": "sum(round(increase(kube_pod_container_status_restarts_total{namespace=\"terrakube\"}[$__range])))",
          "refId": "A",
          "instant": true,
          "range": false
        }
      ],
      "title": "Restarts",
      "type": "stat",
      "description": "Container restarts in the terrakube namespace over the selected range."
    },
    {
      "id": 9,
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 5
      },
      "panels": [],
      "title": "MinIO (Terraform state)",
      "type": "row"
    },
    {
      "id": 10,
      "datasource": {
        "type": "prometheus",
        "uid": "${promDatasource}"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineWidth": 1,
            "showPoints": "never",
            "spanNulls": false,
            "stacking": {
              "group": "A",
              "mode": "normal"
            }
          },
          "unit": "reqps",
          "min": 0
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 6
      },
      "options": {
        "legend": {
          "calcs": [
            "mean",
            "max"
          ],
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${promDatasource}"
          },
          "editorMode": "code",
          "expr": "sum by (api) (rate(minio_s3_requests_total{job=\"terrakube-minio\"}[$__rate_interval]))",
          "refId": "A",
          "instant": false,
          "range": true,
          "legendFormat": "{{api}}"
        }
      ],
      "title": "S3 Requests by API",
      "type": "timeseries",
      "description": "S3 calls handled by MinIO per API (getobject = state/plan reads, putobject = state/log writes from Terrakube api and executor)."
    },
    {
      "id": 11,
      "datasource": {
        "type": "prometheus",
        "uid": "${promDatasource}"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineWidth": 1,
            "showPoints": "never",
            "spanNulls": false,
            "stacking": {
              "group": "A",
              "mode": "none"
            }
          },
          "unit": "reqps",
          "min": 0
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 6
      },
      "options": {
        "legend": {
          "calcs": [
            "mean",
            "max"
          ],
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${promDatasource}"
          },
          "editorMode": "code",
          "expr": "sum(rate(minio_s3_requests_errors_total{job=\"terrakube-minio\"}[$__rate_interval])) or vector(0)",
          "refId": "A",
          "instant": false,
          "range": true,
          "legendFormat": "errors (4xx+5xx)"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${promDatasource}"
          },
          "editorMode": "code",
          "expr": "sum(rate(minio_s3_requests_4xx_errors_total{job=\"terrakube-minio\"}[$__rate_interval])) or vector(0)",
          "refId": "B",
          "instant": false,
          "range": true,
          "legendFormat": "4xx"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${promDatasource}"
          },
          "editorMode": "code",
          "expr": "(sum(rate(minio_s3_requests_rejected_auth_total{job=\"terrakube-minio\"}[$__rate_interval])) + sum(rate(minio_s3_requests_rejected_header_total{job=\"terrakube-minio\"}[$__rate_interval])) + sum(rate(minio_s3_requests_rejected_invalid_total{job=\"terrakube-minio\"}[$__rate_interval])) + sum(rate(minio_s3_requests_rejected_timestamp_total{job=\"terrakube-minio\"}[$__rate_interval]))) or vector(0)",
          "refId": "C",
          "instant": false,
          "range": true,
          "legendFormat": "rejected (auth, header, timestamp, invalid)"
        }
      ],
      "title": "S3 Errors and Rejections",
      "type": "timeseries",
      "description": "Failed S3 requests. Rejected requests never reached an API handler (bad credentials, clock skew, malformed headers). MinIO creates the per-API error series only after the first error, hence the vector(0) fallback."
    },
    {
      "id": 12,
      "datasource": {
        "type": "prometheus",
        "uid": "${promDatasource}"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineWidth": 1,
            "showPoints": "never",
            "spanNulls": false,
            "stacking": {
              "group": "A",
              "mode": "none"
            }
          },
          "unit": "s",
          "min": 0
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 14
      },
      "options": {
        "legend": {
          "calcs": [
            "mean",
            "max"
          ],
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${promDatasource}"
          },
          "editorMode": "code",
          "expr": "histogram_quantile(0.95, sum by (le, api) (rate(minio_s3_requests_ttfb_seconds_distribution{job=\"terrakube-minio\"}[$__rate_interval])))",
          "refId": "A",
          "instant": false,
          "range": true,
          "legendFormat": "{{api}}"
        }
      ],
      "title": "S3 Time to First Byte (p95)",
      "type": "timeseries",
      "description": "95th percentile time to first byte per S3 API."
    },
    {
      "id": 13,
      "datasource": {
        "type": "prometheus",
        "uid": "${promDatasource}"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineWidth": 1,
            "showPoints": "never",
            "spanNulls": false,
            "stacking": {
              "group": "A",
              "mode": "none"
            }
          },
          "unit": "Bps",
          "min": 0
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 14
      },
      "options": {
        "legend": {
          "calcs": [
            "mean",
            "max"
          ],
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${promDatasource}"
          },
          "editorMode": "code",
          "expr": "sum(rate(minio_s3_traffic_received_bytes{job=\"terrakube-minio\"}[$__rate_interval]))",
          "refId": "A",
          "instant": false,
          "range": true,
          "legendFormat": "received (writes)"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${promDatasource}"
          },
          "editorMode": "code",
          "expr": "sum(rate(minio_s3_traffic_sent_bytes{job=\"terrakube-minio\"}[$__rate_interval]))",
          "refId": "B",
          "instant": false,
          "range": true,
          "legendFormat": "sent (reads)"
        }
      ],
      "title": "S3 Traffic",
      "type": "timeseries",
      "description": "S3 payload bytes in and out of MinIO."
    },
    {
      "id": 14,
      "datasource": {
        "type": "prometheus",
        "uid": "${promDatasource}"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineWidth": 1,
            "showPoints": "never",
            "spanNulls": false,
            "stacking": {
              "group": "A",
              "mode": "none"
            }
          },
          "unit": "bytes"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "objects"
            },
            "properties": [
              {
                "id": "unit",
                "value": "short"
              },
              {
                "id": "custom.axisPlacement",
                "value": "right"
              },
              {
                "id": "decimals",
                "value": 0
              }
            ]
          }
        ]
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 22
      },
      "options": {
        "legend": {
          "calcs": [
            "lastNotNull",
            "max"
          ],
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${promDatasource}"
          },
          "editorMode": "code",
          "expr": "max(minio_cluster_usage_total_bytes{job=\"terrakube-minio\"})",
          "refId": "A",
          "instant": false,
          "range": true,
          "legendFormat": "size"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${promDatasource}"
          },
          "editorMode": "code",
          "expr": "max(minio_cluster_usage_object_total{job=\"terrakube-minio\"})",
          "refId": "B",
          "instant": false,
          "range": true,
          "legendFormat": "objects"
        }
      ],
      "title": "Stored Data",
      "type": "timeseries",
      "description": "Data and object count in MinIO over time (updated by MinIO's background scanner, so it moves in steps). There is a single bucket; per-bucket metrics are not scraped."
    },
    {
      "id": 15,
      "datasource": {
        "type": "prometheus",
        "uid": "${promDatasource}"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "unit": "percentunit",
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.8
              },
              {
                "color": "red",
                "value": 0.9
              }
            ]
          },
          "decimals": 1,
          "max": 1
        },
        "overrides": []
      },
