      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum by (level) (count_over_time({namespace=\"$namespace\", pod=~\"$pod\"}\n  | json lvl=\"level\"\n  | drop __error__, __error_details__\n  | label_format level=`{{ if .level }}{{ .level }}{{ else }}{{ .lvl }}{{ end }}`\n  | label_format level=`{{ lower .level }}`\n  | label_format level=`{{ if eq .level \"warning\" }}warn{{ else if eq .level \"err\" }}error{{ else if eq .level \"\" }}unknown{{ else }}{{ .level }}{{ end }}`\n[$__auto]))",
          "legendFormat": "{{level}}",
          "queryType": "range",
          "refId": "A"
        }
      ],
      "title": "Log Rate by Level",
      "type": "timeseries"
