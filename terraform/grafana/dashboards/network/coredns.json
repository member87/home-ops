      }
    },
    {
      "id": 16,
      "type": "timeseries",
      "title": "Cache Hit Ratio per Pod",
      "datasource": {
        "type": "prometheus",
        "uid": "${promDatasource}"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
