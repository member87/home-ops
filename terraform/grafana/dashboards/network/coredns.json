          },
          "editorMode": "code",
          "expr": "sum by (kubernetes_pod_name, zone, proto) (rate(coredns_dns_requests_total{job=\"coredns\"}[$__rate_interval]))",
          "refId": "A",
          "instant": false,
          "range": true,
          "legendFormat": "{{kubernetes_pod_name}} zone={{zone}} {{proto}}"
        }
      ],
      "description": "Query rate per pod, server-block zone and transport. Talos' Corefile has a single '.' server block, so cluster.local and external names share zone '.'.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 14
      }
    },
    {
      "id": 15,
      "type": "row",
      "title": "Cache",
      "collapsed": false,
      "panels": [],
      "gridPos": {
