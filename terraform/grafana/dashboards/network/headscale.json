          "range": true,
          "legendFormat": "{{proto}}"
        }
      ],
      "title": "In-flight Requests",
      "type": "timeseries",
      "description": "HTTP/2.0 = requests inside client Noise tunnels, mostly map long-polls (one per connected node). HTTP/1.1 = the outer listener: open ts2021 Noise tunnels, embedded DERP relay connections and short API/health calls.",
      "id": 17,
      "gridPos": {
        "h": 8,
        "w": 8,
