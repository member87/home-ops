{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      },
      {
        "datasource": {
          "type": "loki",
          "uid": "${lokiDatasource}"
        },
        "enable": true,
        "expr": "{namespace=\"traefik\", container=\"traefik\"} |= \"CrowdsecBouncerTraefikPlugin\" |= \"crowdsecQuery:unreachable\"",
        "iconColor": "red",
        "name": "Bouncer LAPI unreachable",
        "titleFormat": "Bouncer cannot reach LAPI (fail-closed)",
        "textFormat": "{{pod}}"
      }
    ]
  },
  "description": "CrowdSec decisions, banned IPs and Traefik bouncer activity",
  "editable": true,
  "graphTooltip": 1,
  "panels": [
    {
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "id": 1,
      "panels": [],
      "title": "Overview",
      "type": "row"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${promDatasource}"
      },
      "description": "Every IP the bouncer currently refuses: local CrowdSec detections plus the community blocklist.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          },
          "unit": "none",
          "decimals": 0
        },
        "overrides": []
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 0,
        "y": 1
      },
      "id": 2,
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto",
        "wideLayout": true,
        "showPercentChange": false
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${promDatasource}"
          },
          "editorMode": "code",
          "expr": "sum(cs_active_decisions{action=\"ban\"})",
          "refId": "A",
          "instant": true,
          "range": false
        }
      ],
      "title": "Active Bans",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${promDatasource}"
      },
      "description": "Active bans CrowdSec issued itself from the Traefik access logs (origin crowdsec), plus manual cscli bans.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 1
              },
              {
                "color": "red",
                "value": 10
              }
            ]
          },
          "unit": "none",
          "decimals": 0
        },
        "overrides": []
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 4,
        "y": 1
      },
      "id": 3,
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto",
        "wideLayout": true,
        "showPercentChange": false
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${promDatasource}"
          },
          "editorMode": "code",
          "expr": "sum(cs_active_decisions{action=\"ban\", origin=~\"crowdsec|cscli\"}) or vector(0)",
          "refId": "A",
          "instant": true,
          "range": false
        }
      ],
      "title": "Local Bans",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${promDatasource}"
      },
      "description": "Active bans pulled from the CrowdSec Central API (CAPI) and console blocklists. These never appear in the CrowdSec logs.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "purple",
                "value": null
              }
            ]
          },
          "unit": "none",
          "decimals": 0
        },
        "overrides": []
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 8,
        "y": 1
      },
      "id": 4,
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto",
        "wideLayout": true,
        "showPercentChange": false
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${promDatasource}"
          },
          "editorMode": "code",
          "expr": "sum(cs_active_decisions{action=\"ban\", origin=~\"CAPI|lists\"}) or vector(0)",
          "refId": "A",
          "instant": true,
          "range": false
        }
      ],
      "title": "Community Blocklist",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "loki",
        "uid": "${lokiDatasource}"
      },
      "description": "Requests to the public hosts the bouncer answered with 403 before they reached a backend, over the selected range.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 1
              },
              {
                "color": "red",
                "value": 50
              }
            ]
          },
          "unit": "none",
          "decimals": 0
        },
        "overrides": []
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 12,
        "y": 1
      },
      "id": 5,
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto",
        "wideLayout": true,
        "showPercentChange": false
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "${lokiDatasource}"
          },
          "editorMode": "code",
          "expr": "sum(count_over_time({namespace=\"traefik\", container=\"traefik\"} |= \"\\\"DownstreamStatus\\\":403,\" |= \"\\\"OriginStatus\\\":0,\" | json ClientHost, RequestHost | RequestHost !~ `.+\\.lab\\.jackhumes\\.com` [$__range])) or vector(0)",
          "refId": "A",
          "queryType": "instant"
        }
      ],
      "title": "Blocked Requests",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "loki",
        "uid": "${lokiDatasource}"
      },
      "description": "Distinct client IPs the bouncer rejected over the selected range.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 1
              },
              {
                "color": "red",
                "value": 10
              }
            ]
          },
          "unit": "none",
          "decimals": 0
        },
        "overrides": []
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 16,
        "y": 1
      },
      "id": 6,
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto",
        "wideLayout": true,
        "showPercentChange": false
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "${lokiDatasource}"
          },
          "editorMode": "code",
          "expr": "count(sum by (ClientHost) (count_over_time({namespace=\"traefik\", container=\"traefik\"} |= \"\\\"DownstreamStatus\\\":403,\" |= \"\\\"OriginStatus\\\":0,\" | json ClientHost, RequestHost | RequestHost !~ `.+\\.lab\\.jackhumes\\.com` [$__range]))) or vector(0)",
          "refId": "A",
          "queryType": "instant"
        }
      ],
      "title": "Blocked IPs",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "loki",
        "uid": "${lokiDatasource}"
      },
      "description": "Times the Traefik bouncer could not reach the CrowdSec LAPI. It fails closed, so while this is non-zero it 403s every client, legitimate ones included; check the Blocked IPs table against the red annotations.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          },
          "unit": "none",
          "decimals": 0
        },
        "overrides": []
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 20,
        "y": 1
      },
      "id": 7,
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto",
        "wideLayout": true,
        "showPercentChange": false
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "${lokiDatasource}"
          },
          "editorMode": "code",
          "expr": "sum(count_over_time({namespace=\"traefik\", container=\"traefik\"} |= \"CrowdsecBouncerTraefikPlugin\" |= \"crowdsecQuery:unreachable\" [$__range])) or vector(0)",
          "refId": "A",
          "queryType": "instant"
        }
      ],
      "title": "Bouncer LAPI Errors",
      "type": "stat"
    },
    {
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 5
      },
      "id": 8,
      "panels": [],
      "title": "Blocked IPs",
      "type": "row"
    },
    {
      "datasource": {
        "type": "loki",
        "uid": "${lokiDatasource}"
      },
      "description": "Client IPs whose requests the bouncer refused on the public hosts, from the Traefik access log. ClientHost is the real address: Caddy on the edge sets X-Forwarded-For.",
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            },
            "filterable": true
          },
          "mappings": [],
          "noValue": "None"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 6
      },
      "id": 9,
      "options": {
        "cellHeight": "sm",
        "showHeader": true,
        "sortBy": [
          {
            "desc": true,
            "displayName": "Requests"
          }
        ],
        "footer": {
          "show": false,
          "reducer": [
            "sum"
          ],
          "fields": ""
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "${lokiDatasource}"
          },
          "editorMode": "code",
          "expr": "sum by (ClientHost, RequestHost) (count_over_time({namespace=\"traefik\", container=\"traefik\"} |= \"\\\"DownstreamStatus\\\":403,\" |= \"\\\"OriginStatus\\\":0,\" | json ClientHost, RequestHost | RequestHost !~ `.+\\.lab\\.jackhumes\\.com` [$__range]))",
          "refId": "A",
          "queryType": "instant"
        }
      ],
      "transformations": [
        {
          "id": "labelsToFields",
          "options": {
            "mode": "columns"
          }
        },
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "renameByName": {
              "ClientHost": "IP",
              "RequestHost": "Host",
              "Value": "Requests"
            },
            "indexByName": {}
          }
        }
      ],
      "title": "Blocked IPs (rejected by the bouncer)",
      "type": "table"
    },
    {
      "datasource": {
        "type": "loki",
        "uid": "${lokiDatasource}"
      },
      "description": "IPs CrowdSec banned itself over the selected range, one row per IP and scenario.",
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            },
            "filterable": true
          },
          "mappings": [],
          "noValue": "None"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 12,
        "y": 6
      },
      "id": 10,
      "options": {
        "cellHeight": "sm",
        "showHeader": true,
        "sortBy": [
          {
            "desc": true,
            "displayName": "Bans"
          }
        ],
        "footer": {
          "show": false,
          "reducer": [
            "sum"
          ],
          "fields": ""
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "${lokiDatasource}"
          },
          "editorMode": "code",
          "expr": "sum by (ip, scenario, country) (count_over_time({namespace=\"crowdsec\", container=\"crowdsec\"} |= \"ban on Ip\" | regexp `\\) (?P<scenario>\\S+) by ip (?P<ip>\\S+) \\((?P<country>[^/]*)/` [$__range]))",
          "refId": "A",
          "queryType": "instant"
        }
      ],
      "transformations": [
        {
          "id": "labelsToFields",
          "options": {
            "mode": "columns"
          }
        },
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "renameByName": {
              "ip": "IP",
              "scenario": "Scenario",
              "country": "Country",
              "Value": "Bans"
            },
            "indexByName": {}
          }
        }
      ],
      "title": "Local Ban Decisions",
      "type": "table"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${promDatasource}"
      },
      "description": "Active bans by origin and reason.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "unit": "none",
          "decimals": 0,
          "min": 0
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 15
      },
      "id": 11,
      "options": {
        "displayMode": "gradient",
        "orientation": "horizontal",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "showUnfilled": true,
        "valueMode": "color",
        "namePlacement": "left",
        "sizing": "auto",
        "minVizHeight": 16,
        "minVizWidth": 8,
        "maxVizHeight": 300
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${promDatasource}"
          },
          "editorMode": "code",
          "expr": "sort_desc(sum by (origin, reason) (cs_active_decisions{action=\"ban\"}))",
          "refId": "A",
          "instant": true,
          "range": false,
          "legendFormat": "{{origin}} {{reason}}"
        }
      ],
      "title": "Active Bans by Reason",
      "type": "bargauge"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${promDatasource}"
      },
      "description": "Active bans by origin.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineWidth": 1,
            "showPoints": "never",
            "spanNulls": false,
            "stacking": {
              "group": "A",
              "mode": "none"
            },
            "axisPlacement": "auto",
            "axisSoftMin": 0,
            "insertNulls": false
          },
          "unit": "none",
          "min": 0
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 15
      },
      "id": 12,
      "options": {
        "legend": {
          "calcs": [
            "lastNotNull"
          ],
          "displayMode": "table",
          "placement": "right",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${promDatasource}"
          },
          "editorMode": "code",
          "expr": "sum by (origin) (cs_active_decisions{action=\"ban\"})",
          "refId": "A",
          "range": true,
          "legendFormat": "{{origin}}"
        }
      ],
      "title": "Active Bans Over Time",
      "type": "timeseries"
    },
    {
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 23
      },
      "id": 13,
      "panels": [],
      "title": "Blocked Requests Over Time",
      "type": "row"
    },
    {
      "datasource": {
        "type": "loki",
        "uid": "${lokiDatasource}"
      },
      "description": "Bouncer 403s on the public hosts per client IP. Red annotations mark bouncer LAPI errors, when the bouncer was refusing everyone.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 80,
            "lineWidth": 1,
            "showPoints": "never",
            "spanNulls": false,
            "stacking": {
              "group": "A",
              "mode": "normal"
            },
            "axisPlacement": "auto",
            "axisSoftMin": 0,
            "insertNulls": false
          },
          "unit": "none",
          "min": 0
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 24
      },
      "id": 14,
      "interval": "1m",
      "options": {
        "legend": {
          "calcs": [
            "sum"
          ],
          "displayMode": "table",
          "placement": "right",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "${lokiDatasource}"
          },
          "editorMode": "code",
          "expr": "sum by (ClientHost) (count_over_time({namespace=\"traefik\", container=\"traefik\"} |= \"\\\"DownstreamStatus\\\":403,\" |= \"\\\"OriginStatus\\\":0,\" | json ClientHost, RequestHost | RequestHost !~ `.+\\.lab\\.jackhumes\\.com` [$__auto]))",
          "refId": "A",
          "queryType": "range",
          "legendFormat": "{{ClientHost}}"
        }
      ],
      "title": "Blocked Requests by IP",
      "type": "timeseries"
    },
    {
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 32
      },
      "id": 15,
      "panels": [],
      "title": "Detection",
      "type": "row"
    },
    {
      "datasource": {
        "type": "loki",
        "uid": "${lokiDatasource}"
      },
      "description": "Scenario overflows by name. Each one usually becomes a ban unless the IP is whitelisted.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 80,
            "lineWidth": 1,
            "showPoints": "never",
            "spanNulls": false,
            "stacking": {
              "group": "A",
              "mode": "normal"
            },
            "axisPlacement": "auto",
            "axisSoftMin": 0,
            "insertNulls": false
          },
          "unit": "none",
          "min": 0
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 33
      },
      "id": 16,
      "interval": "1m",
      "options": {
        "legend": {
          "calcs": [
            "sum"
          ],
          "displayMode": "table",
          "placement": "right",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "${lokiDatasource}"
          },
          "editorMode": "code",
          "expr": "sum by (scenario) (count_over_time({namespace=\"crowdsec\", container=\"crowdsec\"} |= \"performed '\" | regexp `performed '(?P<scenario>[^']+)'` [$__auto]))",
          "refId": "A",
          "queryType": "range",
          "legendFormat": "{{scenario}}"
        }
      ],
      "title": "Scenario Triggers",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${promDatasource}"
      },
      "description": "Lines CrowdSec read from Loki and how many its parsers understood, per acquisition type. A non-zero unparsed rate means the Traefik access-log format no longer matches crowdsecurity/traefik-logs.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineWidth": 1,
            "showPoints": "never",
            "spanNulls": false,
            "stacking": {
              "group": "A",
              "mode": "none"
            },
            "axisPlacement": "auto",
            "axisSoftMin": 0,
            "insertNulls": false
          },
          "unit": "cps",
